# Python
__pycache__/
*.pyc
*.pyo

# Conda / virtual environments
env/
venv/
ENV/
.venv/
.env/

# OS / editor
.DS_Store
.idea/
.vscode/

# --- Pipeline outputs (regenerated by run_training.sh / run_prediction.sh) ---
# CV / fine-tuning run artifacts
analysis_output/
cv_consensus_nl*/
models/cv_runs/*
!models/cv_runs/.gitkeep

# Fine-tuned FSscore checkpoints produced during training
fsscore/models/checkpoints_alpha/
fsscore/data/processed/*
!fsscore/data/processed/.gitkeep

# Scored / processed intermediates and predictions
data/input/molecules_cleaned.csv
data/processed/*
!data/processed/.gitkeep
data/predictions/*
!data/predictions/.gitkeep

# W&B / lightning logs
wandb/
lightning_logs/
*.log

# --- RESTRICTED: expert annotation records and everything derived from them ---
# The annotation data was collected at an industrial EM facility and is not
# cleared for public release. Stage 1 writes real consensus scores into
# data/output/, which was previously unprotected. Only the dummy fixtures that
# ship with this repo are tracked. Do not relax these rules.
data/input/*.csv
!data/input/dummy_*.csv
!data/input/example_molecules.csv
data/output/*
!data/output/dummy_*.csv
!data/output/.gitkeep
